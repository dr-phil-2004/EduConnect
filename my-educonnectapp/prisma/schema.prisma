// schema.prisma — EduConnect Bénin
// Stack: Next.js + Prisma + Clerk (auth) + Postgres (Supabase/Neon/Railway)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

// ──────────────────────────────
// RÔLES
// ──────────────────────────────

enum Role {
  STUDENT
  TEACHER
  ADMIN
  MINISTRY
}

// ──────────────────────────────
// UTILISATEUR
// clerkId = source de vérité pour l'identité (Clerk)
// ──────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique // vient du webhook Clerk (user.created)
  email     String   @unique
  firstName String?
  lastName  String?
  role      Role     @default(STUDENT)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations "enseignant"
  coursesTaught     Course[]       @relation("TeacherCourses")
  announcementsSent Announcement[] @relation("AnnouncementAuthor")

  // relations "étudiant"
  submissions   Submission[]
  questions     Question[]
  courseAccess  CourseEnrollment[]

  @@index([role])
}

// ──────────────────────────────
// COURS / RESSOURCES
// Contenu léger par défaut (texte + fichier optionnel)
// pour rester utilisable en connexion faible
// ──────────────────────────────

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  content     String   @db.Text // markdown, pas de vidéo lourde par défaut
  fileUrl     String?  // ressource jointe optionnelle (PDF léger)
  audioUrl    String?  // version audio pour accessibilité malvoyants
  subject     String   // ex: "Mathématiques", "Informatique"
  level       String?  // ex: "Licence 1"

  teacherId String
  teacher   User   @relation("TeacherCourses", fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions    Question[]
  submissions  Submission[]
  enrollments  CourseEnrollment[]

  @@index([teacherId])
  @@index([subject])
}

// Inscription d'un étudiant à un cours (pour filtrer "mes cours")
model CourseEnrollment {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())

  @@unique([studentId, courseId])
}

// ──────────────────────────────
// QUESTIONS / RÉPONSES (fil de discussion par cours)
// ──────────────────────────────

model Question {
  id        String   @id @default(cuid())
  content   String   @db.Text
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  answer    String?  @db.Text // réponse de l'enseignant (simplifié pour le MVP)
  answeredAt DateTime?
  createdAt DateTime @default(now())

  @@index([courseId])
}

// ──────────────────────────────
// DEVOIRS / SOUMISSIONS
// ──────────────────────────────

enum SubmissionStatus {
  PENDING
  GRADED
}

model Submission {
  id        String           @id @default(cuid())
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id])
  studentId String
  student   User             @relation(fields: [studentId], references: [id])
  content   String           @db.Text
  fileUrl   String?
  status    SubmissionStatus @default(PENDING)
  grade     Int?             // sur 20, par ex.
  feedback  String?          @db.Text
  createdAt DateTime         @default(now())
  gradedAt  DateTime?

  @@index([courseId])
  @@index([studentId])
}

// ──────────────────────────────
// ANNONCES OFFICIELLES
// Peut être postée par un enseignant OU le ministère (même modèle,
// distingué par le rôle de l'auteur → extensible sans nouveau modèle)
// ──────────────────────────────

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  authorId  String
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  scope     String   @default("GLOBAL") // "GLOBAL" | "COURSE" | courseId spécifique
  createdAt DateTime @default(now())

  @@index([authorId])
}
